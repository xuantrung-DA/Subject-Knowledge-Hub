# Add your own key. Empty/invalid keys produce explicit errors, never mock answers.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# Local Docker-only PostgreSQL password; use URL-safe characters if changing it.
# Existing PostgreSQL volume passwords are not changed by editing this value.
POSTGRES_PASSWORD=hub_local_dev
# Change these if another local application already uses the defaults.
# When changing WEB_PORT, update ALLOWED_ORIGINS below as well.
API_PORT=8000
WEB_PORT=3000
MAX_UPLOAD_MB=100
MAX_PDF_PAGES=1200
CHUNK_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
# Keep citations on one physical page; existing versions retain their index.
CHUNK_PAGE_BOUNDARIES=true
EMBEDDING_BATCH_SIZE=64
EMBEDDING_BATCH_TOKENS=16000
MAX_INGESTION_TOKENS=2000000
MAX_INGESTION_CALLS=200

RETRIEVAL_MODE=dense
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20
MAX_CONTEXT_TOKENS=4500
MAX_HISTORY_TOKENS=1500
MAX_OUTPUT_TOKENS=900
MAX_INPUT_TOKENS=9000
MAX_QUESTION_TOKENS=24000
MAX_QUESTION_CALLS=5
MAX_TOOL_ROUNDS=3
MAX_TOOL_OUTPUT_TOKENS=4500
MAX_TOOL_PAGE_RANGE=10
MAX_SUMMARY_TOKENS=150000
MAX_SUMMARY_CALLS=100
SUMMARY_CONFIRMATION_TOKENS=12000
SUMMARY_BATCH_TOKENS=4500
ANSWER_CACHE_TTL=600
QUERY_CACHE_TTL=3600
CONFIG_VERSION=v1
PROMPT_VERSION=v2

# Optional versioned USD prices; leave {} to display tokens without guessed cost.
# models.{model}.input/output/cached_input are USD per million tokens.
# Set PRICING_UPDATED_AT to the date you verified your configured prices.
PRICING_JSON={}
PRICING_UPDATED_AT=

COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_DAYS=7
CHAT_RATE_LIMIT_PER_MINUTE=12
AUTH_RATE_LIMIT_PER_MINUTE=20
MAX_USER_JOBS=10
JOB_RECONCILE_SECONDS=30
JOB_STALE_SECONDS=180
JOB_MAX_ATTEMPTS=4
JOB_TIMEOUT_SECONDS=7200
LOG_LEVEL=INFO
